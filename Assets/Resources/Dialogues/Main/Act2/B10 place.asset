  m_Script: {fileID: 11500000, guid: 3ea90144ef4ac7a4699131a7438e0496, type: 3}
  m_Name: B10 place
  m_EditorClassIdentifier: Assembly-CSharp::DialogueStateSO
  <Texts>k__BackingField:
  - <Text>k__BackingField: <color=#FF99DD>It is my humble abode. A realm whose only
      master is me. The false laws of the new gods do not apply here. It is here
      where I rest, and test the willpower of potential future worshippers.
    TextAlignment: 260
  - <Text>k__BackingField: <color=#FF99DD>Be not worried, little one. A prison this
      place is not, whether for you or me. In fact, it is a safe-heaven from the
      mad gods' whim, where I quietly gaze at the stars as the days go by. I always
      loved the starry sky, are these still as bright and colourful in your plane
      of existence?
    TextAlignment: 260
  <Illustration>k__BackingField: {fileID: 0}
  <Bgm>k__BackingField: {fileID: 0}
  <SFX>k__BackingField: {fileID: 0}
  <Item>k__BackingField: {fileID: 0}
  <Branches>k__BackingField:
  - Text: '- "What happened to your cult?"'
    Next: {fileID: 11400000, guid: 2556c021282d1cf45a00cf7ba38188fc, type: 2}
  - Text: '- "How did I end up here?"'
    Next: {fileID: 11400000, guid: ff757848546bde744ac65aaf1691eeec, type: 2}
  - Text: '- "You mentioned a ''reward''?"'
    Next: {fileID: 11400000, guid: 1b974c4d9270ee440b4c5f6df71809ba, type: 2}
  - Text: '- "I have no more questions."'
    Next: {fileID: 11400000, guid: 310c89589aaf2b247af5a8ee27aff595, type: 2}

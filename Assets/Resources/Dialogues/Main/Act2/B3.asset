  m_Script: {fileID: 11500000, guid: 3ea90144ef4ac7a4699131a7438e0496, type: 3}
  m_Name: B3
  m_EditorClassIdentifier: Assembly-CSharp::DialogueStateSO
  <Texts>k__BackingField:
  - <Text>k__BackingField: Behind the door lies the observatory room. I could barely
      see it as a glowing spot while I was outside the tower, but now that I'm in,
      it feels impossibly larger on the inside than the outside.
    TextAlignment: 257
  - <Text>k__BackingField: The stars glow brightly outside. The storm seems to have
      receded during my trials. So many constellation and nebulae of all colours
      are visible tonight, whose names are completely eluding me.
    TextAlignment: 257
  - <Text>k__BackingField: There is this sensation of... Peace, coming from this
      place, like a unviolable safe-heaven I'm privileged to join in.
    TextAlignment: 257
  <Illustration>k__BackingField: {fileID: 0}
  <Bgm>k__BackingField: {fileID: 8300000, guid: 5aebf4f1e20dd7448a2b60a2ba555ee6, type: 3}

  m_EditorClassIdentifier: Assembly-CSharp::DialogueStateSO
  <Texts>k__BackingField:
  - <Text>k__BackingField: <color=#FF99DD>Be not afraid.
    TextAlignment: 260
  - <Text>k__BackingField: Tentatively, I step forward. The creature shifts in her
      bed, seemingly to take a better look at me; not that she needs it, given how
      long and mobile her neck is.
    TextAlignment: 257
  - <Text>k__BackingField: <color=#FF99DD>I see you are not afraid of the unknown
      and its dangers. Very well. It has been so long since the last human made his
      way into my realm. I am pleased to see my rituals have not been forgotten.
    TextAlignment: 260
  <Illustration>k__BackingField: {fileID: 0}

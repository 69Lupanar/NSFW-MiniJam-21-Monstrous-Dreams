  m_Name: B8
  m_EditorClassIdentifier: Assembly-CSharp::DialogueStateSO
  <Texts>k__BackingField:
  - <Text>k__BackingField: <color=#FF99DD>I am Cxuixa, a diety from ages long gone.
      Your kind worshipped me, as well as many others, long before they gained the
      ability to put their thoughts down on a tablet of clay.
    TextAlignment: 260
  - <Text>k__BackingField: <color=#FF99DD>Your people, at the time, were still living
      in the fear of tomorrow, watching lightning struck down and waiting for the
      gods' ire to pass. I offered them protection and comfort. In return, they gave
      me their undying devotion.
    TextAlignment: 260
  <Illustration>k__BackingField: {fileID: 0}
  <Bgm>k__BackingField: {fileID: 0}
  <SFX>k__BackingField: {fileID: 0}
  <Item>k__BackingField: {fileID: 0}
  <Branches>k__BackingField:
  - Text: '- "By ''devotion'', you mean...?"'
    Next: {fileID: 11400000, guid: 216b9c88a52bd84408f5876536f12c7b, type: 2}
